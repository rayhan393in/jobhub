# ---------------------------------------------------------------------------
# JobHub environment
#
# Copy to `.env.local` for development. Never commit real keys.
# The service-role key is server-only: it bypasses Row Level Security and must
# never be exposed to the browser or prefixed with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Server-only. Used for catalogue counts and privileged maintenance reads.
# Leave empty to run without it (RLS still applies to everything else).
# Required for written-exam answer-sheet uploads (the storage bucket is private
# and is written through this client after the caller's ownership is verified).
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Applies supabase/migrations/*.sql (npm run db:migrate).
# Use the Supavisor pooler string from Supabase → Project Settings → Database.
SUPABASE_DB_URL=

# Optional. Enables the AI question drafter at /admin/ai.
# Get a free key at https://aistudio.google.com/apikey.
# Without it, /api/admin/ai-generate returns 503 with a setup message.
GEMINI_API_KEY=

# Optional: canonical site URL, used for metadata and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
